{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "UserManagement": "Host=localhost;Port=5432;Database=vairas_user_management;Username=v_user_management_runtime"
  },
  "Authentication": {
    "Authority": "https://localhost:7100",
    "Issuer": "https://localhost:7100",
    "UserAudience": "vairas-user-management",
    "WorkloadAudience": "vairas-user-management-internal",
    "WorkloadClients": { "notifications": ["profiles.contact.read"] }
  },
  "ProfileAccess": {
    "PlatformOperatorIdentityIds": [],
    "BootstrapWorkloads": []
  },
  "Dependencies": {
    "AuthBaseUrl": "https://localhost:7100/",
    "SchoolBaseUrl": "https://localhost:7200/",
    "ConfirmationBaseUrl": "https://localhost:7300/",
    "TokenEndpoint": "https://localhost:7100/connect/token",
    "ClientId": "user-management",
    "Scope": "identity.validate school.profile-provisioning confirmations.validate"
  },
  "Outbox": {
    "Enabled": false,
    "TopicName": "vairas.user.deactivated.v1",
    "PollSeconds": 2
  }
}
